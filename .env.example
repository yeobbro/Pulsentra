# Server-side only. Never put these values in frontend code, Git or shared logs.
KIS_APP_KEY=
KIS_APP_SECRET=
# false = live quote domain; true = KIS paper/sandbox domain. Pulsentra has NO order endpoints either way.
KIS_PAPER=false
KIS_TIMEOUT_SECONDS=12
# Pause between KIS REST calls (KIS applies per-second limits; check the official portal).
KIS_MIN_INTERVAL_SECONDS=0.35

# OpenDART (https://opendart.fss.or.kr) API key for disclosures
DART_API_KEY=

# Storage (MSL_* names from the MVP are still accepted)
# PULSENTRA_DATA_DIR=./data
# PULSENTRA_DB_PATH=./data/market_signal_lab.sqlite3
# PULSENTRA_MODEL_DIR=./data/models

# Cost ASSUMPTIONS for the portfolio engine (basis points). Verify broker fees and the current tax rate.
PULSENTRA_COMMISSION_BPS=1.5
PULSENTRA_SELL_TAX_BPS=20
PULSENTRA_SLIPPAGE_BPS=10
# MVP single-symbol backtest round-trip assumption
DEFAULT_ROUND_TRIP_COST_BPS=40

# Daily series become STALE after this many business days without a new bar
PULSENTRA_STALE_AFTER_BUSINESS_DAYS=2
